<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootHdvList"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F766E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Danh Mục Hướng Dẫn Viên - NhomNoName"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnRefreshHdv"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Làm mới"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Trạng thái 1: Đang tải -->
    <ProgressBar
        android:id="@+id/progressHdvList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="32dp"
        android:visibility="gone" />

    <!-- Trạng thái 3: Lỗi / Rỗng -->
    <LinearLayout
        android:id="@+id/layoutErrorHdv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvErrorHdvMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Không tải được danh sách hướng dẫn viên"
            android:textColor="#64748B"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnRetryHdv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#0F766E"
            android:text="Thử Lại"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- Trạng thái 2: RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHdvList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="16dp" />

</LinearLayout>

