<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Quét QR Điểm Danh Khách Lên Xe/Tàu - NhomNoName"
        android:textColor="#0D47A1"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnMoCameraQuetQr"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#E65100"
        android:text="Mở Camera Quét Mã QR Vé Đoàn"
        android:textColor="@android:color/white" />

    <EditText
        android:id="@+id/edtMaVeThuCong"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="12dp"
        android:background="@android:drawable/editbox_background_normal"
        android:hint="Hoặc nhập mã vé (VD: VE-CGVT-0001)"
        android:paddingHorizontal="12dp" />

    <Button
        android:id="@+id/btnXacNhanDiemDanh"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="#1B5E20"
        android:text="Xác Nhận Điểm Danh Lên Xe/Tàu"
        android:textColor="@android:color/white" />

    <ProgressBar
        android:id="@+id/progressQuetQr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvKetQuaDiemDanh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="#E8F5E9"
        android:padding="16dp"
        android:text="Kết quả điểm danh sẽ hiển thị tại đây"
        android:textColor="#1B5E20"
        android:textSize="15sp" />
</LinearLayout>
