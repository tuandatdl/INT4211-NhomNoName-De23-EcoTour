<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Chào quản trị viên"
            android:textColor="#0D47A1"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Quản lý danh mục &amp; Điều hành (TV2)"
            android:textColor="#374151"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnQuanLyTour"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#047857"
            android:text="Quản Lý Tour Du Lịch"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnQuanLySuat"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#0D9488"
            android:text="Quản Lý Suất Khởi Hành"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnQuanLyHdv"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#0F766E"
            android:text="Quản Lý Hướng Dẫn Viên"
            android:textColor="@android:color/white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Nghiệp vụ Đặt chỗ, Check-in &amp; Báo cáo (TV1 - Nhóm trưởng)"
            android:textColor="#374151"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnQuanLyDatCho"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#1B5E20"
            android:text="Quản Lý Đặt Chỗ &amp; Hủy Tour"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnQuetQr"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#E65100"
            android:text="Quét QR Vé Điểm Danh"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnBaoCao"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#4A148C"
            android:text="Báo Cáo Biểu Đồ Lấp Đầy &amp; Doanh Thu"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#B71C1C"
            android:text="Đăng Xuất"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>
